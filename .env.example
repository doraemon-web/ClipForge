HOST=0.0.0.0
PORT=8000

# Add your GitHub Pages origin here when the frontend is published.
# Example:
# FRONTEND_ORIGINS=https://yourusername.github.io,http://127.0.0.1:8000,http://localhost:8000
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

MAX_VIDEO_DURATION=7200
MAX_CLIP_DURATION=600
MAX_CONCURRENT_JOBS=2

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

MAX_CAPTION_DOWNLOAD_BYTES=10485760
MAX_THUMBNAIL_DOWNLOAD_BYTES=20971520